# ── AI Content Engine Environment Variables ──────────────────
# Copy this file to .env and fill in your values.
# .env is gitignored — your secrets stay local.

# AI Generation (free, no credit card)
# Get at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.0-flash

# YouTube Upload
# Run: go run ./cmd/gentoken/  (on your local machine)
# Paste the JSON output as the value below
YOUTUBE_TOKEN_JSON={"token":"...","refresh_token":"...","token_uri":"...","client_id":"...","client_secret":"..."}
# Content of client_secret.json from Google Cloud Console
YOUTUBE_CLIENT_SECRET_JSON={"installed":{"client_id":"...","client_secret":"...","redirect_uris":[],"auth_uri":"...","token_uri":"..."}}

# Twitter/X (free tier)
# Get at: https://developer.twitter.com
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAA...

# Telegram (free)
# Get token from @BotFather, chat ID from /getUpdates
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=-1001234567890

# Gumroad (free to list)
# Get at: https://app.gumroad.com/advanced
GUMROAD_ACCESS_TOKEN=your_gumroad_token

# Affiliate links (optional JSON override)
# Format: {"keywords":{"tool":"https://..."},"disclaimer":"..."}
AFFILIATE_CONFIG=

# Pipeline settings
CONTENT_TOPIC=AI productivity tools for small businesses
OUTPUT_DIR=./outputs
VIDEO_PRIVACY=unlisted
